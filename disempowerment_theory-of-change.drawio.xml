        <mxCell id="zwVLvU2gcYmJ1tXzipiD-96" value="Maybe I should write, independently from this project, about narrativizing the values of LLMs as capable simulations acting out an agent, the values here are from simulating an agent." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
