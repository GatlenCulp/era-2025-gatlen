        <mxCell id="zwVLvU2gcYmJ1tXzipiD-98" value="Sneaky values embedding themselves into our institutions. Make us weak and easily influenced." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
